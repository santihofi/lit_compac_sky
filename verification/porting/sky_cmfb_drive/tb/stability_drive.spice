** sch_path: /foss/designs/lit_compac_sky/verification/porting/sky_gilbert/tb/tb_gilbert_cell_mult.sch
**.subckt tb_gilbert_cell_mult
Vdd vdd GND {{vdd}}
.save i(vdd)
Vcmi vcmi GND {{vincm}}
Vref vref GND {{vref}}
I0 ibias GND {{ibias*power_m}}
I1 vdd ibias_ota {{ibias*power_m*fast_scale}}
Vd1 vdin1 GND {{vd1}}
E1 in1p vcmi VOL=' v(vdin1)/2 '
E2 in1n vcmi VOL=' -v(vdin1)/2 '
Vd2 vdin2 GND {{vd2}}
E4 in2p vcmi VOL=' v(vdin2)/2 '
E5 in2n vcmi VOL=' -v(vdin2)/2 '
x1 vdd vbias outp outn in1n in1p in2p in2n GND ibias vdd GND vcm_sense gt0 gt1 gt2 gt3 gt4 gilbert_cell
Cloadp outp GND {{c_load}}
Cloadn outn GND {{c_load}}
Vstb vbias vbias_ota dc 0 ac 0
Istb GND vbias dc 0 ac 0
x2 vdd vbias_ota vref vcm_sense GND ibias_ota vdd GND ota
Vgcode gcode GND {{gcode}}
Egt0 gt0 GND VOL=' v(vdd)*(1-(floor((v(gcode)+0.5)/1)-2*floor((v(gcode)+0.5)/2))) '
Egt1 gt1 GND VOL=' v(vdd)*(1-(floor((v(gcode)+0.5)/2)-2*floor((v(gcode)+0.5)/4))) '
Egt2 gt2 GND VOL=' v(vdd)*(1-(floor((v(gcode)+0.5)/4)-2*floor((v(gcode)+0.5)/8))) '
Egt3 gt3 GND VOL=' v(vdd)*(1-(floor((v(gcode)+0.5)/8)-2*floor((v(gcode)+0.5)/16))) '
Egt4 gt4 GND VOL=' v(vdd)*(1-(floor((v(gcode)+0.5)/16)-2*floor((v(gcode)+0.5)/32))) '
**** begin user architecture code


.temp {{ temp }}
.option SEED = {{ (seed|int) + 1 }}
.option method=gear

.control
save all
op
let idd_dc=-i(vdd)
let vb_dc = v(vbias)
let vocm_dc = (v(outp)+v(outn))/2
let vsense_dc = v(vcm_sense)

* run 1: voltage injection
alter vstb acmag=1
alter istb acmag=0
ac dec 40 0.1 10G
let tv = -v(vbias_ota)/v(vbias)

* run 2: current injection, i(vstb) flows from vbias into the OTA output
alter vstb acmag=0
alter istb acmag=1
ac dec 40 0.1 10G
let ii = i(vstb)
let ti = ii/(1-ii)
let tloop = (ac1.tv*ti - 1)/(ac1.tv + ti + 2)

* margins: worst PM over every unity crossing, GM at the first -180 deg crossing
let f = real(frequency)
let tdb = db(tloop)
let tph = 180/pi*cph(tloop)
let npts = length(tdb)
let t0_db = tdb[0]
let t0_re = real(tloop[0])
let ncross = 0
let pm = 999
let fu = 0
let gm_db = 999
let f180 = 0
let k = 1
while k < npts
  let a = tdb[k-1]
  let b = tdb[k]
  if (a >= 0 and b < 0) or (a < 0 and b >= 0)
    let fr = a/(a-b)
    let fc = f[k-1]*(f[k]/f[k-1])^fr
    let pc = tph[k-1] + fr*(tph[k]-tph[k-1])
    let ncross = ncross + 1
    if 180 + pc < pm
      let pm = 180 + pc
      let fu = fc
    end
  end
  if f180 = 0
    if tph[k-1] > -180 and tph[k] <= -180
      let fr = (tph[k-1]+180)/(tph[k-1]-tph[k])
      let f180 = f[k-1]*(f[k]/f[k-1])^fr
      let gm_db = -(tdb[k-1] + fr*(tdb[k]-tdb[k-1]))
    end
  end
  let k = k + 1
end
* no crossing while |T| > 1 at DC, or positive feedback at DC: flag as unstable
if ncross = 0 and t0_db > 0
  let pm = -999
end
if t0_re < 0
  let pm = -999
end

* operating point copied into the current plot for the capture
let vbias_dc = op1.vb_dc
let voutcm_dc = op1.vocm_dc
let vsense = op1.vsense_dc
let idd_dc=op1.idd_dc
quit
.endc





