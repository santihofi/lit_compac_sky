** sch_path: /foss/designs/lit_compac_sky/verification/porting/sky_gilbert/tb/tb_gilbert_cell_mult.sch
**.subckt tb_gilbert_cell_mult
Vdd vdd GND {{vdd}}
.save i(vdd)
Vcmi vcmi GND {{vincm}}
Vref vref GND {{vref}}
I0 ibias GND {{ibias*power_m}}
I1 vdd ibias_ota {{ibias*power_m}}
Vd1 vdin1 GND {{vd1}}
E1 in1p vcmi VOL=' v(vdin1)/2 '
E2 in1n vcmi VOL=' -v(vdin1)/2 '
Vd2 vdin2 GND {{vd2}}
E4 in2p vcmi VOL=' v(vdin2)/2 '
E5 in2n vcmi VOL=' -v(vdin2)/2 '
x1 vdd vbias outp outn in1n in1p in2p in2n GND ibias vdd GND vcm_sense gt0 gt1 gt2 gt3 gt4 gilbert_cell
Cloadp outp GND {{c_load}}
Cloadn outn GND {{c_load}}
x2 vdd vbias vref vcm_sense GND ibias_ota vdd GND ota
Vgcode gcode GND {{gcode}}
Egt0 gt0 GND VOL=' v(vdd)*(1-(floor((v(gcode)+0.5)/1)-2*floor((v(gcode)+0.5)/2))) '
Egt1 gt1 GND VOL=' v(vdd)*(1-(floor((v(gcode)+0.5)/2)-2*floor((v(gcode)+0.5)/4))) '
Egt2 gt2 GND VOL=' v(vdd)*(1-(floor((v(gcode)+0.5)/4)-2*floor((v(gcode)+0.5)/8))) '
Egt3 gt3 GND VOL=' v(vdd)*(1-(floor((v(gcode)+0.5)/8)-2*floor((v(gcode)+0.5)/16))) '
Egt4 gt4 GND VOL=' v(vdd)*(1-(floor((v(gcode)+0.5)/16)-2*floor((v(gcode)+0.5)/32))) '
**** begin user architecture code


.temp {{ temp }}
.option SEED = {{ (seed|int) + 1 }}
.option method=gear

Vreceiver rvdd GND {{vdd}}
Votherp otherp vcmi 0.05
Vothern othern vcmi -0.05
Ireceiver ribias GND {{ibias*power_m}}
Ireceiver_ota rvdd ribias_ota {{ibias*power_m}}
xreceiver rvdd rvbias routp routn {{'outn' if fanout_input==1 else 'othern'}} {{'outp' if fanout_input==1 else 'otherp'}} {{'outp' if fanout_input==2 else 'otherp'}} {{'outn' if fanout_input==2 else 'othern'}} GND ribias rvdd GND rvcm_sense gt0 gt1 gt2 gt3 gt4 gilbert_cell
xreceiver_cmfb rvdd rvbias vref rvcm_sense GND ribias_ota rvdd GND ota
Creceiverp routp GND 100f
Creceivern routn GND 100f
.control
save all
op
let idd=-i(vdd)
alter vd1 dc=0
alter vd2 dc=0.1
alter @vd1[acmag]=1
alter @vd2[acmag]=0
ac dec 60 1k 10g
let gd=v(outp)-v(outn)
let gd_db=20*log10(mag(gd)/mag(gd[0]))
meas ac bw1 when gd_db=-3
set bw1=$&bw1
let ag1=mag(gd[0])
set ag1=$&ag1
let ci1=-imag(i(e1)[180]-i(e2)[180])/(6.28318530718*frequency[180])*1e15
set ci1=$&ci1
let ci1hf=-imag(i(e1)[300]-i(e2)[300])/(6.28318530718*frequency[300])*1e15
set ci1hf=$&ci1hf
alter vd1 dc=0.1
alter vd2 dc=0
alter @vd1[acmag]=0
alter @vd2[acmag]=1
ac dec 60 1k 10g
let gd=v(outp)-v(outn)
let gd_db=20*log10(mag(gd)/mag(gd[0]))
meas ac bw2 when gd_db=-3
let bw_in1_mhz=$bw1/1e6
let bw_in2_mhz=bw2/1e6
let acgain_in1=$ag1
let acgain_in2=mag(gd[0])
let cin1_per_pin_ff=$ci1
let cin1_100mhz_ff=$ci1hf
let cin2_per_pin_ff=-imag(i(e4)[180]-i(e5)[180])/(6.28318530718*frequency[180])*1e15
let cin2_100mhz_ff=-imag(i(e4)[300]-i(e5)[300])/(6.28318530718*frequency[300])*1e15
let idd=op1.idd
quit
.endc





.lib /foss/pdks/sky130A/libs.tech/ngspice/sky130.lib.spice {{ corner_mos }}


