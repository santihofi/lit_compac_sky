** sch_path: /foss/designs/lit_compac/macros/gilbert_cell/testbenches/xschem/tb_gilbert_cell_mult.sch
**.subckt tb_gilbert_cell_mult
Vdd vdd GND {{vdd}}
.save i(vdd)
Vcmi vcmi GND {{vincm}}
Vref vref GND {{vref}}
I0 ibias GND {{ibias}}
I1 vdd ibias_ota {{ibias}}
Vd1 vdin1 GND {{vd1}}
E1 in1p vcmi VOL=' v(vdin1)/2 '
E2 in1n vcmi VOL=' -v(vdin1)/2 '
Vd2 vdin2 GND {{vd2}}
E4 in2p vcmi VOL=' v(vdin2)/2 '
E5 in2n vcmi VOL=' -v(vdin2)/2 '
x1 vdd vbias outp outn in1n in1p in2p in2n GND ibias vdd GND vcm_sense gt0 gt1 gt2 gt3 gt4 gilbert_cell
Cloadp outp GND {{c_load}}
Cloadn outn GND {{c_load}}
x2 vdd vbias vref vcm_sense GND ibias_ota vdd GND ota
Vgcode gcode GND {{gcode}}
Egt0 gt0 GND VOL=' 1.5*(1-(floor((v(gcode)+0.5)/1)-2*floor((v(gcode)+0.5)/2))) '
Egt1 gt1 GND VOL=' 1.5*(1-(floor((v(gcode)+0.5)/2)-2*floor((v(gcode)+0.5)/4))) '
Egt2 gt2 GND VOL=' 1.5*(1-(floor((v(gcode)+0.5)/4)-2*floor((v(gcode)+0.5)/8))) '
Egt3 gt3 GND VOL=' 1.5*(1-(floor((v(gcode)+0.5)/8)-2*floor((v(gcode)+0.5)/16))) '
Egt4 gt4 GND VOL=' 1.5*(1-(floor((v(gcode)+0.5)/16)-2*floor((v(gcode)+0.5)/32))) '
**** begin user architecture code


.temp {{ temp }}
.option SEED = {{ (seed|int) + 1 }}
.option method=gear

.control
save all
op
let vo=v(outp)-v(outn)
let cm=(v(outp)+v(outn))/2
let idd=-i(vdd)
let tail_margin=@n.x1.xm13.nsg13_lv_pmos[vsat]
let pair_margin=@n.x1.xm1.nsg13_lv_pmos[vsat]
let mirror_margin=@n.x1.xm5.nsg13_lv_nmos[vsat]
let quad_margin=@n.x1.xm7.nsg13_lv_nmos[vsat]
let qs=v(x1.qs1)
let sp=v(x1.vcm1)
alter vd1 dc=0.1
alter vd2 dc=0.1
op
let vo=v(outp)-v(outn)
alter vd1 dc=-0.1
alter vd2 dc=0.1
op
let vo=v(outp)-v(outn)
alter vd1 dc=-0.1
alter vd2 dc=-0.1
op
let vo=v(outp)-v(outn)
alter vd1 dc=0.1
alter vd2 dc=-0.1
op
let vo=v(outp)-v(outn)
alter vd1 dc=0.01
alter vd2 dc=0.01
op
let vo=v(outp)-v(outn)
alter vd1 dc=-0.01
alter vd2 dc=0.01
op
let vo=v(outp)-v(outn)
alter vd1 dc=-0.01
alter vd2 dc=-0.01
op
let vo=v(outp)-v(outn)
alter vd1 dc=0.01
alter vd2 dc=-0.01
op
let vo=v(outp)-v(outn)
let k100=(op2.vo-op3.vo+op4.vo-op5.vo)/0.04
let k10=(op6.vo-op7.vo+op8.vo-op9.vo)/0.0004
let compr=k100/k10
let vocm=op1.cm
let idd=op1.idd
let vos=op1.vo
let tail_margin=op1.tail_margin
let pair_margin=op1.pair_margin
let mirror_margin=op1.mirror_margin
let quad_margin=op1.quad_margin
let qs=op1.qs
let sp=op1.sp
alter vd1 dc=0
alter vd2 dc=0.1
alter @vd1[acmag]=1
alter @vd2[acmag]=0
ac dec 60 1k 10g
let gd=mag(v(outp)-v(outn))
let gain0=gd[0]
let gd_db=20*log10(gd/gain0)
meas ac bw1 when gd_db=-3
set bw1=$&bw1
set ag1=$&gain0
alter vd1 dc=0.1
alter vd2 dc=0
alter @vd1[acmag]=0
alter @vd2[acmag]=1
ac dec 60 1k 10g
let gd=mag(v(outp)-v(outn))
let gain0=gd[0]
let gd_db=20*log10(gd/gain0)
meas ac bw2 when gd_db=-3
let bw_in1_mhz=$bw1/1e6
let bw_in2_mhz=bw2/1e6
let acgain_in1=$ag1
let acgain_in2=gain0
let k100=op9.k100
let k10=op9.k10
let compr=op9.compr
let vocm=op9.vocm
let idd=op9.idd
let vos=op9.vos
let tail_margin=op9.tail_margin
let pair_margin=op9.pair_margin
let mirror_margin=op9.mirror_margin
let quad_margin=op9.quad_margin
let qs=op9.qs
let sp=op9.sp
quit
.endc





.lib cornerMOSlv.lib mos_{{ corner_mos }}
.lib cornerRES.lib res_{{ corner_res }}
.lib cornerCAP.lib cap_{{ corner_cap }}


**** end user architecture code
**.ends

