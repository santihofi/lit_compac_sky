** sch_path: /foss/designs/lit_compac_sky/verification/porting/sky_gilbert/tb/tb_gilbert_cell_mult.sch
**.subckt tb_gilbert_cell_mult
Vdd vdd GND {{vdd}}
.save i(vdd)
Vcmi vcmi GND {{vincm}}
Vref vref GND {{vref}}
I0 ibias GND {{ibias}}
I1 vdd ibias_ota {{ibias}}
Vd1 vdin1 GND {{vd1}}
E1 in1p vcmi VOL=' v(vdin1)/2 '
E2 in1n vcmi VOL=' -v(vdin1)/2 '
Vd2 vdin2 GND {{vd2}}
E4 in2p vcmi VOL=' v(vdin2)/2 '
E5 in2n vcmi VOL=' -v(vdin2)/2 '
x1 vdd vbias outp outn in1n in1p in2p in2n GND ibias vdd GND vcm_sense gt0 gt1 gt2 gt3 gt4 gilbert_cell
Cloadp outp GND {{c_load}}
Cloadn outn GND {{c_load}}
x2 vdd vbias vref vcm_sense GND ibias_ota vdd GND ota
Vgcode gcode GND {{gcode}}
Egt0 gt0 GND VOL=' v(vdd)*(1-(floor((v(gcode)+0.5)/1)-2*floor((v(gcode)+0.5)/2))) '
Egt1 gt1 GND VOL=' v(vdd)*(1-(floor((v(gcode)+0.5)/2)-2*floor((v(gcode)+0.5)/4))) '
Egt2 gt2 GND VOL=' v(vdd)*(1-(floor((v(gcode)+0.5)/4)-2*floor((v(gcode)+0.5)/8))) '
Egt3 gt3 GND VOL=' v(vdd)*(1-(floor((v(gcode)+0.5)/8)-2*floor((v(gcode)+0.5)/16))) '
Egt4 gt4 GND VOL=' v(vdd)*(1-(floor((v(gcode)+0.5)/16)-2*floor((v(gcode)+0.5)/32))) '
**** begin user architecture code


.temp {{ temp }}
.option SEED = {{ (seed|int) + 1 }}
.option method=gear

.control
save all
* op1..op21: (vd1, vd2) points; every op plot gets vout = v(outp)-v(outn)
op
let vout = v(outp)-v(outn)
let vocm = (v(outp)+v(outn))/2
alter vd1 dc=0.1
alter vd2 dc=0.1
op
let vout = v(outp)-v(outn)
alter vd1 dc=-0.1
op
let vout = v(outp)-v(outn)
alter vd2 dc=-0.1
op
let vout = v(outp)-v(outn)
alter vd1 dc=0.1
op
let vout = v(outp)-v(outn)
* feedthrough points: one input at +-100 mV, the other at 0
alter vd2 dc=0
op
let vout = v(outp)-v(outn)
alter vd1 dc=-0.1
op
let vout = v(outp)-v(outn)
alter vd1 dc=0
alter vd2 dc=0.1
op
let vout = v(outp)-v(outn)
alter vd2 dc=-0.1
op
let vout = v(outp)-v(outn)
* small-signal four-quadrant at +-10 mV (op10..op13)
alter vd1 dc=0.01
alter vd2 dc=0.01
op
let vout = v(outp)-v(outn)
alter vd1 dc=-0.01
op
let vout = v(outp)-v(outn)
alter vd2 dc=-0.01
op
let vout = v(outp)-v(outn)
alter vd1 dc=0.01
op
let vout = v(outp)-v(outn)
* in1 at +-100 mV, in2 at +-10 mV (op14..op17)
alter vd1 dc=0.1
alter vd2 dc=0.01
op
let vout = v(outp)-v(outn)
alter vd1 dc=-0.1
op
let vout = v(outp)-v(outn)
alter vd2 dc=-0.01
op
let vout = v(outp)-v(outn)
alter vd1 dc=0.1
op
let vout = v(outp)-v(outn)
* in1 at +-10 mV, in2 at +-100 mV (op18..op21)
alter vd1 dc=0.01
alter vd2 dc=0.1
op
let vout = v(outp)-v(outn)
alter vd1 dc=-0.01
op
let vout = v(outp)-v(outn)
alter vd2 dc=-0.1
op
let vout = v(outp)-v(outn)
alter vd1 dc=0.01
op
let vout = v(outp)-v(outn)
* transfer curves: vs vd1 at vd2 = +100 mV (dc1), vs vd2 at vd1 = +100 mV (dc2)
alter vd2 dc=0.1
dc vd1 -0.2 0.2 0.005
let vout_v1 = v(outp)-v(outn)
alter vd1 dc=0.1
dc vd2 -0.2 0.2 0.005
let vout_v2 = v(outp)-v(outn)
* scalars, K = vout/(v1*v2) from four-quadrant differences (offsets and feedthrough cancel)
let k100 = (op2.vout - op3.vout - op5.vout + op4.vout)/(4*0.1*0.1)
let k10 = (op10.vout - op11.vout - op13.vout + op12.vout)/(4*0.01*0.01)
let k_in1big = (op14.vout - op15.vout - op17.vout + op16.vout)/(4*0.1*0.01)
let k_in2big = (op18.vout - op19.vout - op21.vout + op20.vout)/(4*0.01*0.1)
let compr = k100/k10
let compr1 = k_in1big/k10
let compr2 = k_in2big/k10
let vout_pp = op2.vout
let vos_out = op1.vout
let vocm = op1.vocm
* feedthrough of one input, referred to the other input as an equivalent offset
let vos2_eq = (op6.vout - op7.vout)/(2*k10*0.1)
let vos1_eq = (op8.vout - op9.vout)/(2*k10*0.1)
quit
.endc





.lib /foss/pdks/sky130A/libs.tech/ngspice/sky130.lib.spice {{ corner_mos }}


**** end user architecture code
**.ends

